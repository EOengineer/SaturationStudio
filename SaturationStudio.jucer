<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="SatS001" name="SaturationStudio" projectType="audioplug" version="0.1.0"
              bundleIdentifier="com.saturationstudio.SaturationStudio" companyName="SaturationStudio"
              companyWebsite="https://example.com" companyCopyright="SaturationStudio"
              pluginManufacturerCode="SatS" pluginCode="Sat1"
              pluginName="SaturationStudio" pluginDesc="Frequency-selective analog-modeled saturation."
              pluginManufacturer="SaturationStudio" pluginAUIsSandboxSafe="1"
              pluginFormats="buildVST3,buildAU"
              pluginCharacteristicsValue=""
              useAppConfig="0" addUsingNamespaceToJuceHeader="1"
              cppLanguageStandard="17" jucerFormatVersion="1"
              userNotes="Multiband-ready saturator shell with topology models.">
  <MAINGROUP id="SatSGrp" name="SaturationStudio">
    <GROUP id="SatSSrc" name="Source">
      <FILE id="ppH" name="PluginProcessor.h" compile="0" resource="0" file="Source/PluginProcessor.h"/>
      <FILE id="ppC" name="PluginProcessor.cpp" compile="1" resource="0" file="Source/PluginProcessor.cpp"/>
      <FILE id="peH" name="PluginEditor.h" compile="0" resource="0" file="Source/PluginEditor.h"/>
      <FILE id="peC" name="PluginEditor.cpp" compile="1" resource="0" file="Source/PluginEditor.cpp"/>
      <GROUP id="SatSUt" name="util">
        <FILE id="piH" name="ParamIDs.h" compile="0" resource="0" file="Source/util/ParamIDs.h"/>
      </GROUP>
      <GROUP id="SatSDsp" name="dsp">
        <FILE id="fdH" name="FirDesign.h" compile="0" resource="0" file="Source/dsp/FirDesign.h"/>
        <FILE id="lpH" name="LinearPhaseBandSplit.h" compile="0" resource="0" file="Source/dsp/LinearPhaseBandSplit.h"/>
        <FILE id="lpR" name="LinearPhaseBandSplitRT.h" compile="0" resource="0" file="Source/dsp/LinearPhaseBandSplitRT.h"/>
        <FILE id="osH" name="Oversampler.h" compile="0" resource="0" file="Source/dsp/Oversampler.h"/>
        <FILE id="saH" name="SpectrumAnalyzer.h" compile="0" resource="0" file="Source/dsp/SpectrumAnalyzer.h"/>
        <FILE id="seH" name="SaturationEngine.h" compile="0" resource="0" file="Source/dsp/SaturationEngine.h"/>
        <GROUP id="SatSMod" name="models">
          <FILE id="smH" name="SaturationModel.h" compile="0" resource="0" file="Source/dsp/models/SaturationModel.h"/>
          <FILE id="mrH" name="ModelRegistry.h" compile="0" resource="0" file="Source/dsp/models/ModelRegistry.h"/>
          <FILE id="dmH" name="DiodeModel.h" compile="0" resource="0" file="Source/dsp/models/DiodeModel.h"/>
          <FILE id="tmH" name="TubeModel.h" compile="0" resource="0" file="Source/dsp/models/TubeModel.h"/>
          <FILE id="tpH" name="TapeModel.h" compile="0" resource="0" file="Source/dsp/models/TapeModel.h"/>
          <FILE id="trH" name="TransformerModel.h" compile="0" resource="0" file="Source/dsp/models/TransformerModel.h"/>
          <FILE id="pmH" name="PreampModel.h" compile="0" resource="0" file="Source/dsp/models/PreampModel.h"/>
        </GROUP>
        <GROUP id="SatSVer" name="verify">
          <FILE id="bvH" name="BandSplitVerify.h" compile="0" resource="0" file="Source/dsp/verify/BandSplitVerify.h"/>
          <FILE id="evH" name="EnginePassthroughVerify.h" compile="0" resource="0" file="Source/dsp/verify/EnginePassthroughVerify.h"/>
        </GROUP>
      </GROUP>
      <GROUP id="SatSUi" name="ui">
        <FILE id="hwH" name="HardwarePanelLook.h" compile="0" resource="0" file="Source/ui/HardwarePanelLook.h"/>
        <FILE id="spH" name="SpectrumMeter.h" compile="0" resource="0" file="Source/ui/SpectrumMeter.h"/>
        <FILE id="mpH" name="ModelPicker.h" compile="0" resource="0" file="Source/ui/ModelPicker.h"/>
        <FILE id="phH" name="ParamHost.h" compile="0" resource="0" file="Source/ui/ParamHost.h"/>
      </GROUP>
    </GROUP>
    <GROUP id="SatSRes" name="Resources"/>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_plugin_client" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_utils" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_dsp" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>
  <EXPORTFORMATS>
    <XCODE_MAC targetFolder="Builds/MacOSX">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug" isDebug="1" optimisation="1" targetName="SaturationStudio"/>
        <CONFIGURATION name="Release" isDebug="0" optimisation="3" targetName="SaturationStudio"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_audio_plugin_client" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_core" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_data_structures" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_dsp" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_events" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_graphics" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics" path="libs/JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra" path="libs/JUCE/modules"/>
      </MODULEPATHS>
    </XCODE_MAC>
  </EXPORTFORMATS>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1" JUCE_VST3_CAN_REPLACE_VST2="0"/>
</JUCERPROJECT>
